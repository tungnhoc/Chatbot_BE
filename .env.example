# Copy values into your local .env; never commit real credentials.
PORT=5000
FLASK_JWT_SECRET_KEY=replace-with-a-long-random-secret
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=chatbot
MYSQL_USER=chatbot
MYSQL_PASSWORD=
# Optional DATABASE_URL overrides MYSQL_*; URL-encode credentials when using it.
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/chatbot
HF_TOKEN=
GROQ_API_KEY=
# Set to a model available in your Groq account.
GROQ_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.2
PIPECONE_API_KEY=
PIPECONE_PDF_CHUNK_INDEX=
PIPECONE_PDF_SUMMARY_INDEX=
# Must be a persistent, shared filesystem for web and worker processes.
DOCUMENT_STORAGE_DIR=storage/documents
# Default hosted backend requires Hugging Face credits.
EMBEDDING_BACKEND=huggingface
# Optional: install requirements-local.txt and set EMBEDDING_BACKEND=local-onnx.
# Use a NEW namespace and re-upload all documents when changing embedding backend.
PINECONE_NAMESPACE=
EMBEDDING_CACHE_DIR=storage/models
